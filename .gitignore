/target
.env
.env.*
!.env.example

# Root-level node_modules (no root package.json commits deps here, but
# various npx/vitest invocations transiently create one) — a stray vitest
# cache file under it was accidentally committed at some point and kept
# showing as "modified" on every local test run since.
/node_modules/

# Python local environment artifacts
.venv/
__pycache__/
*.pyc
crates/ghostlink-gui/frontend/node_modules/
crates/ghostlink-gui/frontend/dist/

# Vendored GUI local runtime artifacts
third_party/mohawk_gui/__pycache__/
third_party/mohawk_gui/certs/

# Local runtime output and diagnostics artifacts
tmp/
artifacts/release/
crates/ghostlink-gui/src-tauri/target/
crates/ghostlink-gui/src-tauri/gen/schemas/

# Local quickstart config bootstrap artifact
ghostlink.toml

# Runtime settings persisted by the API (auto-generated, machine-specific)
settings.json

# Local scratch / runtime artifacts that should never be committed
.git_commit_msg
server.log
.github_pr_template.md

# Local native-runtime bootstrap artifacts
third_party/llama.cpp/
stories15M-q4_0.gguf

# Binary executables and installers (never track these)
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.bin

# Temporary report and working files (never commit session artifacts)
REPORT_*.md
*_REPORT.md
*_SUMMARY.md
*_READINESS.md
*_READY.md
OUTPUT.md

# Generated files
ghostlink_backend.log
ghostlink_frontend.log
logs/
$null
opencode.json
launch-fast.sh
models/*.gguf
models/
# Downloaded by scripts/rpc_fabric_benchmark.py's own instructions / manual
# curl (see docs/BENCHMARKS.md's 2026-08-08 Multi-Node Performance entry) —
# same reasoning as models/*.gguf above, just a different directory name
# since docker-compose.rpc-fabric-benchmark.yml bind-mounts it in without
# touching the CI-gate's Dockerfile.rpc-fabric image.
models-bench/*.gguf
models.json
sessions.json
# Generated on first run — a real per-install secret / self-signed cert,
# never something to commit or share across installs.
api_key.txt
tls_cert.pem
tls_key.pem
# Same category, same repo-root default paths (auth.rs's
# GHOSTLINK_JWT_SECRET_FILE, main.rs's GHOSTLINK_API_KEYS_FILE): the JWT
# signing secret and the hashed RBAC key store the API writes on first run.
# These were previously untracked only by accident — nothing stopped a
# `git add -A` from committing a live signing secret.
jwt_secret.txt
api_keys.json
# The audit trail is append-only runtime state (auth events, timestamps,
# source IPs), not source or a fixture — a copy under crates/ghost-link/
# had accumulated real local test runs and was tracked.
audit_log.jsonl
ghostlink_gui_modern/dist/
sdks/js/node_modules/
sdks/js/dist/
sdks/python/build/
sdks/python/dist/
sdks/python/*.egg-info/

# mcp_servers.toml is a per-install copy of mcp_servers.example.toml (same
# pattern as ghostlink.toml/ghostlink.example.toml) — the GUI's MCP tab writes
# enable/disable toggles back to it, so it shouldn't be tracked.
mcp_servers.toml

# Runtime data created by MCP servers (see mcp_servers.toml) — not source
mcp_workspace/ghostlink.db
rag_index.json

# Local demo recordings (large binaries, not source)
/demo/

# Claude Code's own local tooling state (settings, launch config, and any
# scratch worktrees it creates) — not project source.
.claude/

# MCP filesystem tool sandbox scratch files (see mcp_workspace/ghostlink.db
# above) — anything else written there during a session is throwaway too.
mcp_workspace/*.txt

# MCP agent identity/bootstrap scratch files generated in the sandbox — not
# Ghostlink project content
mcp_workspace/ACADEMIC_PAPER.pdf
mcp_workspace/BOOTSTRAP.md
mcp_workspace/HEARTBEAT.md
mcp_workspace/IDENTITY.md
mcp_workspace/SOUL.md
mcp_workspace/TOOLS.md
mcp_workspace/USER.md

# Regenerated by launch-native.ps1 on every run — not meant to be hand-edited
# or tracked (see the file's own header comment).
ghostlink_gui_modern/public/env-config.js

# Task-agent runtime state. The task runtime writes its JSON store under
# GHOSTLINK_DATA_DIR (default `.ghostlink/data`), and — more importantly —
# stages every proposed file mutation under
# `.ghostlink/tasks/<task_id>/proposed/` inside whichever project an agent
# is pointed at. That staging tree is derived, reviewable, and disposable:
# it must never be committed into a user's repository.
.ghostlink/

# Assistant runtime state (phase 3 approval queue, phase 1 memory store).
# Both are derived, machine-local, and disposable: the queue holds the tool
# arguments of pending actions, which is exactly the kind of thing that must
# never be committed into a user's repository.
approvals.json
schedules.json
ghostlink_memory.db

# llama.cpp prebuilt binaries (downloaded, not source) and locally-fetched
# GGUF weights. Neither belongs in the repo.
tools/llama.cpp/
models/nomic-embed-text*.gguf

# RAG indexes and memory stores are derived, machine-local, and disposable.
# A llama-server-embedded index runs ~240MB, so it must never be committed.
rag_index.json
rag_llama.json
*.db

# Scratch notes from working sessions. Documentation that belongs in the repo
# goes in docs/; these are per-session and only meaningful to their author.
AGENTS_AND_CHANGELOG_REVIEW.md
ghostlink_gui_modern/FIX_401_ERROR.md
test_curl_cleaned.js
# SQLite WAL sidecars for the memory store.
ghostlink_memory.db-*
session_summaries.json
# Ad-hoc audit/PR scratch notes; the durable record is CHANGELOG.md
docs/PR_NOTE_*.md

# Playwright local test artifacts
.playwright-mcp/
