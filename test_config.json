{
  "test_suite": {
    "name": "ghostlink-gui-suite",
    "description": "Comprehensive test suite for Ghostlink GUI components",
    "version": "1.0.0",
    "author": "Ghostlink Team"
  },
  "gui_test_plan": {
    "core_functionality": [
      {
