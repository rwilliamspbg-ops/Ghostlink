# Multi-stage Ghostlink production-ready build
# Optimized for layer caching and minimal final image size
# Supports multi-arch builds via docker buildx --platform linux/amd64,linux/arm64

# Build stage
FROM --platform=$BUILDPLATFORM rust:1.89-bookworm as builder
ARG TARGETARCH
ARG TARGETPLATFORM
WORKDIR /build

# Copy workspace manifests and source
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Install cross-compilation toolchain if needed
RUN if [ "$TARGETARCH" = "arm64" ]; then \
    apt-get update && \
    apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && \
    rm -rf /var/lib/apt/lists/*; \
    fi

# Build application
RUN if [ "$TARGETARCH" = "arm64" ]; then \
    export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc && \
    export CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc && \
    export CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ && \
    cargo build --release --target aarch64-unknown-linux-gnu -p ghost-link -p ghostlink-core; \
    else \
    cargo build --release -p ghost-link -p ghostlink-core; \
    fi

# Runtime stage
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    net-tools \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 ghostlink \
    && useradd -u 10001 -g ghostlink -m -s /bin/false ghostlink

COPY --from=builder /build/target/*/release/ghost-link /usr/local/bin/
WORKDIR /app
COPY . .
RUN mkdir -p /shared && chown -R ghostlink:ghostlink /app /shared
ENV GHOSTLINK_TLS_CERT_PATH="/tmp/tls_cert.pem"
ENV GHOSTLINK_TLS_KEY_PATH="/tmp/tls_key.pem"

USER ghostlink

# Default to no special role; accept role via environment or CLI args
ENV GHOSTLINK_TCP_AUTH_TOKEN=""
ENV GHOSTLINK_ROLE="worker"
ENTRYPOINT ["ghost-link"]
CMD ["--help"]
