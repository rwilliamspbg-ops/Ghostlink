# Multi-stage build for Ghostlink GUI
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY ghostlink_gui_modern/package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source
COPY ghostlink_gui_modern/ ./

# Build
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config
COPY deploy/nginx.gui.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
