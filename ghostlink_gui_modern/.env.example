# Ghostlink GUI Environment Variables

# Backend API URL (when not using Vite proxy)
# Leave empty to use Vite proxy (http://localhost:8003)
# Set this for production deployments
VITE_API_URL=http://localhost:8003

# API timeout in milliseconds
VITE_API_TIMEOUT=5000

# Long-form timeout for streaming requests (chat)
VITE_API_STREAM_TIMEOUT=120000

# Worker polling interval in milliseconds
VITE_WORKER_POLL_INTERVAL=5000

# Enable debug logging
VITE_DEBUG=false
