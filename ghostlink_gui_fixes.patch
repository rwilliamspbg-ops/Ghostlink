+/// backend's HTTP API) unconditionally; everything else it uses is either
+/// guarded by a try/except (`huggingface_hub`) or not imported at all.
+const REQUIRED_GUI_PYTHON_MODULES: &[&str] = &["tkinter", "requests"];
+
+/// Optional modules: the GUI degrades gracefully without these (e.g. the
+/// Hugging Face search box just shows an error dialog instead of crashing),
+/// so their absence should be surfaced as a warning, never as a blocking
+/// preflight failure.
+const OPTIONAL_GUI_PYTHON_MODULES: &[&str] = &["huggingface_hub"];
+
 fn detect_missing_gui_python_modules(python: &str) -> Result<Vec<String>> {
+    detect_missing_python_modules(python, REQUIRED_GUI_PYTHON_MODULES)
+}
+
+fn detect_missing_optional_gui_python_modules(python: &str) -> Result<Vec<String>> {
+    detect_missing_python_modules(python, OPTIONAL_GUI_PYTHON_MODULES)
+}
+
