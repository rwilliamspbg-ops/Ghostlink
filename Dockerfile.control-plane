FROM golang:1.24-alpine AS builder
WORKDIR /build
COPY control-plane/ .
RUN CGO_ENABLED=0 go build -o /control-plane .

FROM alpine:3.19
RUN apk add --no-cache ca-certificates \
    && addgroup -g 10001 controlplane \
    && adduser -u 10001 -G controlplane -D controlplane
COPY --from=builder /control-plane /usr/local/bin/

USER controlplane
EXPOSE 8000
CMD ["control-plane"]
